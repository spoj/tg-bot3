# systemd user template: copy to ~/.config/systemd/user/, then
#   systemctl --user enable --now tg-bot3@<name>
# Instance <name> keeps its state in ~/<name>; config.json there sets the bridge and hc launch options.
[Unit]
Description=tg-bot3 Telegram gateway (%i)

[Service]
WorkingDirectory=%h/tg-bot3
ExecStart=/usr/bin/env node src/main.ts %h/%i
Environment=PATH=%h/.local/bin:%h/.bun/bin:%h/.cargo/bin:/usr/local/bin:/usr/bin:/bin
Restart=on-failure
RestartSec=5s
KillMode=mixed
TimeoutStopSec=15s

[Install]
WantedBy=default.target
